# Default local demo: no Synapt or model credentials are used.
SYNAPT_MODE=fixture
SYNAPT_MCP_URL=https://synapt.example.com/tristore/mcp/
# This value is a complete token endpoint despite the original BASE variable name.
SYNAPT_AUTH_BASE=https://synapt.example.com/auth_service/api/v1/auth/token
SYNAPT_USERNAME=
SYNAPT_PASSWORD=
SYNAPT_PROVIDER_ID=synapt_final_capstone
SYNAPT_TOP_K=5
SYNAPT_GRAPH_HOPS=2
# Live auth encoding must match the team-provided API contract.
SYNAPT_AUTH_ENCODING=json
# Verified beta tenant expects an email field; SYNAPT_USERNAME holds that login email.
SYNAPT_AUTH_USERNAME_FIELD=email
SYNAPT_TIMEOUT_SECONDS=20
CLAIMS_DATABASE_PATH=data/runtime/claims.sqlite
CLAIMS_AUTH_ENABLED=true
# Optional override; otherwise auth.sqlite is stored beside the claims database.
CLAIMS_AUTH_DATABASE_PATH=data/runtime/auth.sqlite
CLAIMS_SEARCH_ENABLED=true
CLAIMS_SEARCH_MODEL=sentence-transformers/all-MiniLM-L6-v2
CLAIMS_SEARCH_CACHE_DIR=artifacts/search-model
CLAIMS_SEARCH_MIN_SIMILARITY=0.34
AGENT_MODE=fixture
# For live NVIDIA NIM calls: set AGENT_MODE=live and NVIDIA_API_KEY.
# The example stays credential-free and defaults to fixture agents.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
# For another endpoint, supply its separate LLM_API_KEY; NVIDIA keys are scoped to NVIDIA.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096
LLM_ENABLE_THINKING=false
# Optional local API access protection; required before exposing beyond loopback.
CLAIMS_API_KEY=
CLAIMS_DATA_PATH=data/raw/claims_sample.json
CLAIMS_ARTIFACT_DIR=artifacts/models
# Optional DeepEval judge; install uv sync --extra evaluation and supply judge credentials.
DEEPEVAL_MODEL=nvidia/nemotron-3-super-120b-a12b
# Disable optional evaluator telemetry.
DEEPEVAL_TELEMETRY_OPT_OUT=1
