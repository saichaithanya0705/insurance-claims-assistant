# Copy this file to `.env.local` (git ignores it) and put your own Anthropic key in it. Values here override `.env`.
# `.env` and `.env.local` are both git-ignored. Keep every key out of tracked files, including this example.

# Claude writes the brief (classification, findings, recommendations) and reads the intake notes.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# A small fast model for the short structured calls, a larger one for the investigation's findings. Change them here, nowhere else.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_CLASSIFICATION=claude-haiku-5-5
ANTHROPIC_MODEL_RECOMMENDATION=claude-haiku-5-5
ANTHROPIC_MODEL_INTAKE=claude-haiku-5-5
ANTHROPIC_MODEL_INVESTIGATION=claude-sonnet-5-5

# The independent judge stays on its own provider (NVIDIA, with the key already in `.env`) so the writer and its reviewer are different models.
# To judge with Claude instead, name a model that does not write the brief, for example:
# JUDGE_PROVIDER=anthropic
# JUDGE_MODEL=claude-opus-5-5
